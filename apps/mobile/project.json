{
  "name": "mobile",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "expo start",
        "cwd": "apps/mobile"
      },
      "dependsOn": [
        "index-images",
        "^index-images"
      ],
      "continuous": true,
      "cache": false
    },
    "android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "expo start --android",
        "cwd": "apps/mobile"
      },
      "dependsOn": [
        "index-images",
        "^index-images"
      ],
      "continuous": true,
      "cache": false
    },
    "ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "expo start --ios",
        "cwd": "apps/mobile"
      },
      "dependsOn": [
        "index-images",
        "^index-images"
      ],
      "continuous": true,
      "cache": false
    },
    "web": {
      "executor": "nx:run-commands",
      "options": {
        "command": "expo start --web",
        "cwd": "apps/mobile"
      },
      "dependsOn": [
        "index-images",
        "^index-images"
      ],
      "continuous": true,
      "cache": false
    },
    "index-images": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/index-images.ts",
        "cwd": "apps/mobile"
      },
      "inputs": [
        "imageIndexer",
        "{projectRoot}/assets/svg/**",
        "{projectRoot}/assets/images/**",
        "!{projectRoot}/assets/images/converted-svg/**",
        "{projectRoot}/scripts/index-images.ts"
      ],
      "outputs": [
        "{projectRoot}/src/lib/image-sources.ts",
        "{projectRoot}/assets/images/converted-svg"
      ],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/mobile"
      },
      "dependsOn": [
        "index-images",
        "^index-images"
      ],
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/tsconfig.json"
      ],
      "cache": true
    }
  }
}