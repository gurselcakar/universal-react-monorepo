{
  "name": "universal-react-monorepo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nx run-many -t dev",
    "build": "nx --no-tui run-many -t build",
    "typecheck": "nx --no-tui run-many -t typecheck",
    "format": "nx --no-tui format:write",
    "format:check": "nx --no-tui format:check",
    "lint": "nx --no-tui run-many -t lint --configuration=fix",
    "lint:check": "nx --no-tui run-many -t lint",
    "test": "nx --no-tui run-many -t test",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@chalkboard/eslint-config-base": "workspace:*",
    "@chalkboard/prettier-config": "workspace:*",
    "@chalkboard/commit-conventions": "workspace:*",
    "@nx/eslint": "22.6.1",
    "@nx/next": "22.6.1",
    "@nx/vite": "22.6.1",
    "@nx/web": "22.6.1",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.21",
    "@types/node": "^22.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "9.1.7",
    "jiti": "2.4.2",
    "lint-staged": "16.4.0",
    "nx": "22.6.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tsx": "^4.21.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "react-native": "0.83.2",
      "react-native-web": "0.21.1",
      "tailwindcss": "3.4.18",
      "vite": "^6.3.5"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,yaml,yml,md}": [
      "prettier --write"
    ]
  }
}
